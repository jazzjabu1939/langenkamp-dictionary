source "https://rubygems.org"

# This Gemfile is for LOCAL PREVIEW only.
# GitHub Pages builds the live site server-side using its own pinned gem set.
# We use a modern Jekyll + the same theme here to get a faithful preview
# without dragging in github-pages' frozen Ruby 2.x toolchain.

gem "jekyll", "~> 4.4"
gem "jekyll-theme-cayman"
gem "kramdown-parser-gfm"
gem "csv"
gem "base64"
gem "logger"

# Live reload for the dev server
gem "webrick"
